# پروفایل ۱: توسعه با MSW (بدون وابستگی به backend)
# - VITE_USE_MSW=true
# - VITE_ENABLE_DEV_BYPASS=true
# - VITE_API_URL را خالی بگذارید
#
# پروفایل ۲: اتصال به backend واقعی/لوکال
# - VITE_USE_MSW=false
# - VITE_ENABLE_DEV_BYPASS=false
# - VITE_DEV_PROXY_TARGET را روی backend مقصد بگذارید

# آدرس API (خالی = همان origin)
VITE_API_URL=

# mock با MSW در dev — برای فقط proxy و backend واقعی مقدار false بگذارید
VITE_USE_MSW=true

# هدف proxy مندرج در vite.config (server.proxy) برای dev
VITE_DEV_PROXY_TARGET=https://api.amline.ir

# CRM از API به‌جای localStorage (نیاز به مسیرهای /admin/crm در backend)
VITE_USE_CRM_API=false

# ورود آزمایشی توسعه (برای محیط واقعی false)
VITE_ENABLE_DEV_BYPASS=true
