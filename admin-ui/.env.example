# پورت‌های پیشنهادی dev (بدون تداخل):
#   backend 8080 | amline-ui 3000 | admin-ui 3002 | consultant-ui 3004 | site 3001
#
# پروفایل ۱: توسعه با MSW (بدون وابستگی به backend)
# - VITE_USE_MSW=true
# - VITE_ENABLE_DEV_BYPASS=true
# - VITE_API_URL را خالی بگذارید
#
# پروفایل ۲: اتصال به backend واقعی/لوکال (docker compose یا uvicorn روی 8080)
# - VITE_USE_MSW=false
# - VITE_ENABLE_DEV_BYPASS=false
# - VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
#
# ورود روی mock یا backend dev/staging: موبایل 09100000000 — OTP 11111 (docs/LOCAL_DEV.md)

# آدرس API (خالی = همان origin)
VITE_API_URL=

# mock با MSW در dev — برای فقط proxy و backend واقعی مقدار false بگذارید
VITE_USE_MSW=true

# هدف proxy مندرج در vite.config (server.proxy) برای dev (لوکال: http://127.0.0.1:8080)
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080

# (legacy) در کد فعلی CRM همیشه از crmApi/backend است؛ این کلید در سرویس استفاده نمی‌شود
VITE_USE_CRM_API=false

# ورود آزمایشی توسعه (برای محیط واقعی false)
VITE_ENABLE_DEV_BYPASS=true

# صفحهٔ قراردادهای PR (Hamgit)
# VITE_FLAG_PR_CONTRACTS_PAGE=true

# هاب «ادغام Hamgit» و placeholderهای ماژول قدیمی (در پروداکشن بدون این کلید خاموش می‌ماند)
VITE_FLAG_HAMGIT_PORT=true
