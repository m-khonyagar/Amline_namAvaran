{
  "name": "@amline/monorepo",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "admin-ui",
    "amline-ui",
    "consultant-ui",
    "site",
    "packages/amline-ui-core",
    "packages/amline-openapi-types"
  ],
  "scripts": {
    "build": "turbo run build",
    "openapi:export": "python backend/backend/scripts/export_openapi.py",
    "openapi:types": "npm run generate -w @amline/openapi-types",
    "openapi:refresh": "npm run openapi:export && npm run openapi:types",
    "lint": "turbo run lint --continue",
    "test": "turbo run test --continue",
    "ensure-ui-core": "node scripts/ensure-ui-core.mjs",
    "dev:admin": "npm run ensure-ui-core && npm run dev -w amline-admin-ui",
    "dev:app": "npm run ensure-ui-core && npm run dev -w amline-ui",
    "dev:site": "npm run dev -w amline-site",
    "dev:consultant": "npm run ensure-ui-core && npm run dev -w amline-consultant-ui",
    "storybook:ui-core": "npm run storybook -w @amline/ui-core"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  }
}
