# ============================================
# اَملاین - Amline Platform Environment Variables
# ============================================

# ==================== General ====================
APP_ENV=staging
APP_DEBUG=true
APP_NAME=Amline
APP_VERSION=1.0.0
APP_URL=http://localhost:8080

# ==================== Security ====================
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars-replace-with-openssl
JWT_SECRET=your-jwt-secret-key-change-in-production-replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE=3600
JWT_REFRESH_EXPIRE=86400
CLI_PASSWORD=admin_cli_password_change_me

# ==================== Database ====================
POSTGRES_USER=amline
POSTGRES_PASSWORD=amline_secret
POSTGRES_DB=amline
DATABASE_URL=postgresql://amline:amline_secret@postgres:5432/amline

# ==================== Redis ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=amline_redis_secret
REDIS_DB=0

# ==================== MinIO ====================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=amline
MINIO_SECRET_KEY=amline_minio_secret
MINIO_PUBLIC_BUCKET=public
MINIO_PRIVATE_BUCKET=private
MINIO_BUCKET=contracts
MINIO_URL_EXPIRE_MINUTES=60

# ==================== RabbitMQ (Optional) ====================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=amline
RABBITMQ_PASSWORD=amline_rabbitmq_secret

# ==================== PDF Generator ====================
PDF_GENERATOR_SERVICE_URL=http://pdf-generator:8000

# ==================== JWT/Auth ====================
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=5

# ==================== SMS Providers ====================
KAVENEGAR_API_KEY=your-kavenegar-api-key
KAVENEGAR_OTP_TEMPLATE=your-otp-template-name

TSMS_USERNAME=your-tsms-username
TSMS_PASSWORD=your-tsms-password
TSMS_SENDER_NUMBER=your-sender-number

# ==================== Bank Gateways ====================
ZARINPAL_TOKEN=your-zarinpal-token
ZARINPAL_ENDPOINT=https://www.zarinpal.com/pg/rest/WebGate/PaymentRequest.json
ZARINPAL_CALL_BACK_URL=http://localhost:8080/payments/zarinpal/callback

PARSIAN_TOKEN=your-parsian-token
PARSIAN_ENDPOINT=https://pep.shaparak.ir/Api/v1/PaymentRequest
PARSIAN_CALL_BACK_URL=http://localhost:8080/payments/parsian/callback

BANK_GATEWAY_REDIRECT_URL=http://localhost:3000/payment/result

# ==================== Monitoring ====================
SENTRY_DSN=
ELASTIC_SEARCH_HOST=localhost
ELASTIC_SEARCH_PORT=9200
ELASTIC_PASSWORD=

# ==================== External Services ====================
KENAR_DIVAR_API_KEY=your-kenar-divar-api-key
KENAR_DIVAR_APP_SLUG=your-app-slug
KENAR_DIVAR_CLIENT_SECRET=your-client-secret
KENAR_DIVAR_REDIRECT_URI=http://localhost:8080/divar/callback

EITAA_BOT_TOKEN=your-eitaa-bot-token
EITAA_YAR_TOKEN=your-eitaa-yar-token
EITAA_SIGN_NOTIFY_CHANNEL=your-channel-id

BALE_CLIENT_ID=your-bale-client-id
BALE_CLIENT_SECRET=your-bale-client-secret

TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ==================== Mail ====================
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@amline.ir
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ==================== SMS Queues ====================
SMS_QUEUE=sms_queue

# ==================== Discount/Promo ====================
DISCOUNT_SALT=your-discount-salt-key

# ==================== Snowflake ID ====================
SNOWFLAKE_MACHINE_ID=1

# ==================== Amline URLs ====================
AMLINE_FRONTEND_URL=http://localhost:3000
AMLINE_API_URL=http://localhost:8080

# ==================== Host Panel (Optional) ====================
HOST_PANEL_URL=
HOST_PANEL_TOKEN=
HOST_PANEL_PROJECT=

# ==================== AI Services (Optional) ====================
AMLINE_AI_URL=https://chabroknet.de01.lexoya.com/ai/langchain

# ==================== GSC / Data Storage ====================
# Optional: Project root path for GSC data (defaults to project root)
# CTO_PROJECT_ROOT=C:/path/to/project  # Optional - has sensible default

# ==================== Google Search Console (GSC) ====================
# Required: Path to Google Service Account JSON key file
# Get this from Google Cloud Console > IAM & Admin > Service Accounts
# Share your GSC property with the service account email (xxx@xxx.iam.gserviceaccount.com)
GSC_KEY_FILE=/path/to/your-service-account-key.json

# Optional: Google Sheet ID for syncing GSC data
# Format: The ID from your Google Sheet URL: docs.google.com/spreadsheets/d/THIS_PART/edit
GSC_SHEET_ID=
