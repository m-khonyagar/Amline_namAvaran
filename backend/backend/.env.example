# Backend environment — copy to .env and fill in values
AMLINE_ENV=dev
AMLINE_DATABASE_URL=postgresql+psycopg://amline:amline_secret@localhost:5432/amline
AMLINE_REDIS_URL=redis://:amline_redis_secret@localhost:6379/0
AMLINE_JWT_SECRET=change-me-in-production-use-long-random-string
AMLINE_JWT_ISSUER=amline
AMLINE_JWT_ACCESS_MINUTES=60
AMLINE_JWT_REFRESH_DAYS=30
AMLINE_OTP_TTL_SECONDS=120

# S3/MinIO
AMLINE_S3_ENDPOINT_URL=http://localhost:9000
AMLINE_S3_ACCESS_KEY=amline
AMLINE_S3_SECRET_KEY=amline_minio_secret
AMLINE_S3_BUCKET=amline-docs

# Dev convenience: این موبایل هنگام اولین login به Admin تبدیل می‌شود
AMLINE_BOOTSTRAP_ADMIN_MOBILE=09120000000
