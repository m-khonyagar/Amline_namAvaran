# ─── توسعه محلی (کپی به .env.local) ─────────────────────────────────────
# npm run dev → پورت 3000 (در صورت اشغال: npx next dev -p 3001)
#
# مقصد API — معمولاً dev-mock-api روی 8080 (run.ps1 یا scripts/dev-user-stack.ps1)
NEXT_PUBLIC_DEV_PROXY_TARGET=http://127.0.0.1:8080
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080

# ورود آزمایشی: فقط وقتی true و NODE_ENV=development معتبر است (lib/auth.ts)
# در production این متغیر را ست نکنید یا حتماً false بگذارید.
NEXT_PUBLIC_ENABLE_DEV_BYPASS=true
#
# ورود واقعی روی mock/backend dev: موبایل 09100000000 — OTP 11111 (مستند: docs/LOCAL_DEV.md)

# ─── production / staging ────────────────────────────────────────────────
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# بدون NEXT_PUBLIC_ENABLE_DEV_BYPASS
# سند: docs/PRODUCTION_CHECKLIST.md
